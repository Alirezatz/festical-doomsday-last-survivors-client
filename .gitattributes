# Normalize line endings: keep source files LF in the repository, check out
# native endings per platform.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.sln     text eol=crlf
*.axaml   text
*.json    text
*.md      text
*.ps1     text eol=crlf
*.yml     text eol=lf

# Binary assets
*.ico     binary
*.pcapng  binary
*.pcap    binary
*.exe     binary
*.zip     binary
*.gz      binary
